          <binding type="control" level="ui" position="4" parameter="TEXT" translation="fixed_value"
                   translationValue="Algorithm 1 · Single chain Op6→Op5→Op4→Op3→Op2→Op1 · Carrier at 0.5× (sub-octave) · Op6 self-feedback"/>
        </option>

        <option name="Brass">
