<?xml version="1.0" encoding="UTF-8"?>

<!--
  FM6 - DX7 Classics
  Five iconic DX7-style sounds in one preset. Select from the dropdown.

  UI controls (position index for bindings):
    0 – label  : title "FM6 – DX7 Classics"
    1 – label  : "Sound" sub-label
    2 – menu   : Sound selector
    3 – label  : description (updated by menu bindings)
    4 – label  : algorithm info (updated by menu bindings)
-->

<DecentSampler minVersion="1.12.0">

  <ui width="812" height="375" bgColor="FF080810">
    <tab name="main">

      <!-- ── Title ────────────────────────────────────────────────── -->
      <!-- position 0 -->
      <label x="20" y="10" width="560" height="28"
             text="FM6 – DX7 Classics"
             textColor="FFD8D8FF" fontSize="22"/>

      <!-- ── Sound selector ────────────────────────────────────────── -->
      <!-- position 1 -->
      <label x="20" y="47" width="60" height="15"
             text="Sound" textColor="FF8080AA" fontSize="11"/>

      <!-- position 2 -->
      <menu x="20" y="63" width="240" height="26"
            parameterName="Sound" value="1"
            textColor="FFFFFFFF" backgroundColour="FF141430"
            outlineColor="FF5555AA">

        <option name="E Piano">
          <binding type="general" level="group" position="0" parameter="ENABLED" translation="fixed_value" translationValue="true"/>
          <binding type="general" level="group" position="1" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
          <binding type="general" level="group" position="2" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
          <binding type="general" level="group" position="3" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
