<?xml version="1.0" encoding="UTF-8"?>

<!-- A Moog-style monophonic lead: two detuned saws that glide between overlapping notes, a resonant
     lowpass filter swept by its own envelope, and an LFO for vibrato. -->
<DecentSampler minVersion="1.30.0">
  <ui width="812" height="375" bgColor="FFF2F2F2" layoutMode="relative" bgMode="top_left">
    <tab name="main">
      <!-- Amp envelope. Instrument-level ENV_* bindings set the envelope on <groups>, which both oscillators inherit. -->
      <labeled-knob x="10" y="20" width="90" label="Attack" valueType="float" minValue="0.0" maxValue="2.0" value="0.01" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK"/>
      </labeled-knob>
      <labeled-knob x="110" y="20" width="90" label="Decay" valueType="float" minValue="0.0" maxValue="3.0" value="0.3" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY"/>
      </labeled-knob>
      <labeled-knob x="210" y="20" width="90" label="Sustain" valueType="float" minValue="0.0" maxValue="1.0" value="0.7" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"/>
      </labeled-knob>
      <labeled-knob x="310" y="20" width="90" label="Release" valueType="float" minValue="0.0" maxValue="5.0" value="0.5" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"/>
      </labeled-knob>
      <labeled-knob x="420" y="20" width="90" label="Glide Time" valueType="float" minValue="0.0" maxValue="2.0" value="0.1" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="GLIDE_TIME"/>
      </labeled-knob>
      <labeled-knob x="530" y="20" width="90" label="Volume" valueType="float" minValue="0.0" maxValue="1.0" value="0.8" textColor="FF000000">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME"/>
      </labeled-knob>

      <!-- Filter. Env Amount is the depth of the filter envelope (modulator 1), which adds up to 6000 Hz to the cutoff. -->
      <labeled-knob x="10" y="130" width="90" label="Cutoff" valueType="float" minValue="20" maxValue="22000" value="800" textColor="FF000000">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_FREQUENCY"/>
      </labeled-knob>
      <labeled-knob x="110" y="130" width="90" label="Resonance" valueType="float" minValue="0.1" maxValue="5.0" value="2.0" textColor="FF000000">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_RESONANCE"/>
      </labeled-knob>
      <labeled-knob x="210" y="130" width="90" label="Env Amount" valueType="float" minValue="0.0" maxValue="1.0" value="0.5" textColor="FF000000">
        <binding type="modulator" level="instrument" modulatorIndex="1" parameter="MOD_AMOUNT"/>
      </labeled-knob>

      <!-- Second oscillator: its tuning in semitones relative to the first, and its level. -->
      <labeled-knob x="10" y="240" width="90" label="Detune" valueType="float" minValue="-1.0" maxValue="1.0" value="0.1" textColor="FF000000">
        <binding type="amp" level="group" position="1" parameter="GROUP_TUNING"/>
      </labeled-knob>
      <labeled-knob x="110" y="240" width="90" label="Mix" valueType="float" minValue="0.0" maxValue="1.0" value="0.6" textColor="FF000000">
        <binding type="amp" level="group" position="1" parameter="AMP_VOLUME"/>
      </labeled-knob>

      <!-- Vibrato: the rate and depth of the LFO (modulator 0). -->
      <labeled-knob x="320" y="240" width="90" label="LFO Rate" valueType="float" minValue="0.1" maxValue="10.0" value="5.0" textColor="FF000000">
        <binding type="modulator" level="instrument" modulatorIndex="0" parameter="FREQUENCY"/>
      </labeled-knob>
      <labeled-knob x="420" y="240" width="90" label="LFO-&gt;Pitch" valueType="float" minValue="0.0" maxValue="1.0" value="0.15" textColor="FF000000">
        <binding type="modulator" level="instrument" modulatorIndex="0" parameter="MOD_AMOUNT"/>
      </labeled-knob>
    </tab>
    <keyboard/>
  </ui>

  <!-- polyphony="1" makes each oscillator monophonic, so glideMode="legato" slides from note to note
       when notes overlap, like portamento on a classic mono synth. -->
  <groups attack="0.01" decay="0.3" sustain="0.7" release="0.5" volume="0.8" glideTime="0.1" glideMode="legato" polyphony="1">
    <group name="Osc1" tags="osc1">
      <oscillator waveform="saw"/>
    </group>
    <group name="Osc2" tags="osc2" groupTuning="0.1" volume="0.6">
      <oscillator waveform="saw"/>
    </group>
  </groups>

  <effects>
    <effect type="lowpass" frequency="800" resonance="2.0"/>
  </effects>

  <modulators>
    <!-- Modulator 0: vibrato. At full depth it swings both oscillators by half a semitone either way. -->
    <lfo shape="sine" frequency="5.0" modAmount="0.15" scope="global">
      <binding type="amp" level="group" tags="osc1,osc2" parameter="GROUP_TUNING" modBehavior="add" translation="linear" translationOutputMin="-0.5" translationOutputMax="0.5"/>
    </lfo>
    <!-- Modulator 1: the filter envelope, adding up to 6000 Hz to the cutoff. It is global, like the filter it
         sweeps, so it restarts on every new note and starts its release when any key is let go. -->
    <envelope attack="0.01" decay="0.4" sustain="0.2" release="0.5" modAmount="0.5" scope="global">
      <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_FREQUENCY" modBehavior="add" translation="linear" translationOutputMin="0" translationOutputMax="6000"/>
    </envelope>
  </modulators>
</DecentSampler>
